<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckGameDependencies">
    <Import Project=".\local.props" Condition="Exists('.\local.props')" />
    <Import Project=".\Sts2PathDiscovery.props" />

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <AssemblyName>TogawaSakiko</AssemblyName>
        <RootNamespace>TogawaSakiko</RootNamespace>
        <Version>0.1.0</Version>
        <InformationalVersion>0.1.0-native-bootstrap</InformationalVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <Deterministic>true</Deterministic>
        <DebugType>portable</DebugType>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefaultItemExcludes>$(DefaultItemExcludes);packages/**;artifacts/**</DefaultItemExcludes>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
        <NoWarn>$(NoWarn);MSB3270;STS001;STS003</NoWarn>

        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <NativeManifestPath>$(MSBuildProjectDirectory)\TogawaSakiko.json</NativeManifestPath>
        <ModStagingPath Condition="'$(ModStagingPath)' == ''">$(MSBuildProjectDirectory)\artifacts\stage\$(AssemblyName)</ModStagingPath>
        <StagedPckPath>$(ModStagingPath)\$(AssemblyName).pck</StagedPckPath>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.1.9" PrivateAssets="All" />
        <AdditionalFiles Include="TogawaSakiko\localization\**\*.json" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="NativeCode\**\*.cs" />
        <None Include="local.props.example" />
        <None Include="project.godot" />
        <None Include="export_presets.cfg" />
        <None Include="TogawaSakiko.json" />
        <None Include="TogawaSakiko\**\*" />
    </ItemGroup>

    <Target Name="CheckGameDependencies">
        <Error Text="Slay the Spire 2 data was not found at '$(Sts2DataDir)'. Configure local.props from local.props.example."
               Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
        <Error Text="sts2.dll was not found at '$(Sts2DataDir)\sts2.dll'."
               Condition="!Exists('$(Sts2DataDir)\sts2.dll')" />
        <Error Text="0Harmony.dll was not found at '$(Sts2DataDir)\0Harmony.dll'."
               Condition="!Exists('$(Sts2DataDir)\0Harmony.dll')" />
    </Target>

    <Target Name="CheckGodotDependency">
        <Error Text="MegaDot was not found at '$(GodotPath)'. Configure local.props from local.props.example."
               Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')" />
    </Target>

    <Target Name="StageNativeCode" DependsOnTargets="Build">
        <MakeDir Directories="$(ModStagingPath)" />
        <ItemGroup>
            <NativeCodeStageFiles Include="$(TargetPath)" />
            <NativeCodeStageFiles Include="$(TargetDir)$(AssemblyName).pdb"
                                  Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
            <NativeCodeStageFiles Include="$(NativeManifestPath)" />
        </ItemGroup>
        <Copy SourceFiles="@(NativeCodeStageFiles)" DestinationFolder="$(ModStagingPath)" />
    </Target>

    <Target Name="ImportModAssets" DependsOnTargets="CheckGodotDependency">
        <Exec Command="&quot;$(GodotPath)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --import"
              EnvironmentVariables="MSBUILDDISABLENODEREUSE=1" />
    </Target>

    <Target Name="ExportModPck" DependsOnTargets="ImportModAssets">
        <MakeDir Directories="$(ModStagingPath)" />
        <Exec Command="&quot;$(GodotPath)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;BasicExport&quot; &quot;$(StagedPckPath)&quot;"
              EnvironmentVariables="MSBUILDDISABLENODEREUSE=1" />
    </Target>

    <Target Name="ValidateNativePackage">
        <Error Text="Staged DLL is missing: $(ModStagingPath)\$(AssemblyName).dll"
               Condition="!Exists('$(ModStagingPath)\$(AssemblyName).dll')" />
        <Error Text="Staged manifest is missing: $(ModStagingPath)\$(AssemblyName).json"
               Condition="!Exists('$(ModStagingPath)\$(AssemblyName).json')" />
        <Error Text="Staged PCK is missing: $(StagedPckPath)"
               Condition="!Exists('$(StagedPckPath)')" />
    </Target>

    <Target Name="PackNativeMod"
            DependsOnTargets="StageNativeCode;ExportModPck;ValidateNativePackage" />

    <Target Name="RequireLocalDeploymentOptIn">
        <Error Text="LocalModsPath is not configured."
               Condition="'$(LocalModsPath)' == ''" />
        <Error Text="Deployment is explicit. Pass -p:AllowLocalDeploy=true to deploy the staged mod."
               Condition="'$(AllowLocalDeploy)' != 'true'" />
    </Target>

    <Target Name="DeployNativeMod"
            DependsOnTargets="RequireLocalDeploymentOptIn;PackNativeMod">
        <MakeDir Directories="$(LocalModsPath)\$(AssemblyName)" />
        <ItemGroup>
            <NativeDeployFiles Include="$(ModStagingPath)\$(AssemblyName).dll" />
            <NativeDeployFiles Include="$(ModStagingPath)\$(AssemblyName).pdb"
                               Condition="Exists('$(ModStagingPath)\$(AssemblyName).pdb')" />
            <NativeDeployFiles Include="$(ModStagingPath)\$(AssemblyName).json" />
            <NativeDeployFiles Include="$(ModStagingPath)\$(AssemblyName).pck" />
        </ItemGroup>
        <Copy SourceFiles="@(NativeDeployFiles)"
              DestinationFolder="$(LocalModsPath)\$(AssemblyName)" />
    </Target>
</Project>
